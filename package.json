{
  "name": "kraftheinz-automation",
  "version": "1.0.0",
  "description": "Playwright automation for comparing Preview vs Production URLs",
  "scripts": {
    "compare": "playwright test tests/compare-urls.spec.ts",
    "compare:headed": "playwright test tests/compare-urls.spec.ts --headed",
    "install:browsers": "playwright install chromium",
    "allure:generate": "node scripts/generate-allure-with-history.mjs",
    "test": "playwright test",
    "crawl:oscar-mayer": "node sites/oscar-mayer/crawler.mjs",
    "compare:oscar-mayer": "playwright test sites/oscar-mayer/compare.spec.ts",
    "site:oscar-mayer": "npm run crawl:oscar-mayer && npm run compare:oscar-mayer",
    "nav:oscar-mayer": "TARGET_ENV=both playwright test sites/oscar-mayer/navigation.spec.ts",
    "nav:oscar-mayer:preview": "TARGET_ENV=preview playwright test sites/oscar-mayer/navigation.spec.ts",
    "nav:oscar-mayer:production": "TARGET_ENV=production playwright test sites/oscar-mayer/navigation.spec.ts",
    "crawl:heinz": "node sites/heinz/crawler.mjs",
    "compare:heinz": "playwright test sites/heinz/compare.spec.ts",
    "locales:heinz": "node sites/heinz/list-locales.mjs",
    "site:heinz": "npm run crawl:heinz && npm run compare:heinz",
    "audit:heinz-recettes": "node sites/heinz/recettes-audit.mjs",
    "analyze": "playwright test tests/analyze-page.spec.ts",
    "analyze:report": "playwright show-report"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "typescript": "^5.4.5"
  }
}
