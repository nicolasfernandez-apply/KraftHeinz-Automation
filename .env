# URL Comparison Configuration
# Copy this file to .env and fill in your values

# The preview/staging URL to compare against production
PREVIEW_URL=https://heinz.prv.kraftheinz.com/en-CA/poutineketchup

# The production URL
PRODUCTION_URL=https://www.heinz.com/en-CA/poutineketchup


# ── Preview Authentication ───────────────────────────────────────────────────
# Leave PREVIEW_USERNAME / PREVIEW_PASSWORD empty if no login is required.

PREVIEW_USERNAME=dxp-prv-access@kraftheinz.com 
PREVIEW_PASSWORD=G34cerf@loop

# Auth type: "form" (login form, default) | "basic" (HTTP Basic Auth)
PREVIEW_AUTH_TYPE=form

# For form login: explicit URL of the login page.
# Defaults to PREVIEW_URL if not set (most apps redirect there automatically).
# PREVIEW_LOGIN_URL=https://preview.example.com/login

# For form login: override default CSS selectors if the standard ones don't match.
# PREVIEW_USERNAME_SELECTOR=input[name="email"]
# PREVIEW_PASSWORD_SELECTOR=input[type="password"]
# PREVIEW_SUBMIT_SELECTOR=button[type="submit"]