# macOS metadata files
.DS_Store
**/.DS_Store

# Environment variables — contains credentials, never commit
.env

# Saved IAP session cookies (created by setupPreviewAuth, contain auth tokens)
.auth/

# Dependencies
node_modules/

# Generated reports and screenshots — never committed; folders are recreated
# by the test runners on demand.
reports/
playwright-report/
test-results/

# Allure — raw results, generated report, and history cache
allure-results/
allure-report/
.allure-history-cache/

# GitHub Pages staging directories (used by update-pages-history-site script)
.pages-site/
.pages-artifact/

# TypeScript build output
dist/

# Site-generated files (created by crawler scripts, not committed)
sites/*/pages.json
sites/*/reports/
